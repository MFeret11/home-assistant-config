{#- Kitchen dashboard markup (dashboards/kitchen.yaml). Data comes from
    packages/kitchen_display.yaml. After editing, run
    homeassistant.reload_custom_templates. -#}

{%- set WX = 'weather.whole_house_national_weather_service_kphl' -%}

{#- NWS calls an hour "rainy" even at a 10% chance, so only show rain icons
    once the chance is worth acting on. -#}
{%- macro wx_icon(cond, pop=100, night=false) -%}
  {%- set wet = ['rainy', 'pouring', 'lightning-rainy', 'snowy', 'snowy-rainy', 'hail', 'lightning'] -%}
  {%- set c = 'cloudy' if cond in wet and pop < 30 else cond -%}
  {%- set m = {
    'clear-night': 'weather-night', 'cloudy': 'weather-cloudy', 'exceptional': 'alert-circle-outline',
    'fog': 'weather-fog', 'hail': 'weather-hail', 'lightning': 'weather-lightning',
    'lightning-rainy': 'weather-lightning-rainy', 'partlycloudy': 'weather-night-partly-cloudy' if night else 'weather-partly-cloudy',
    'pouring': 'weather-pouring', 'rainy': 'weather-rainy', 'snowy': 'weather-snowy',
    'snowy-rainy': 'weather-snowy-rainy', 'sunny': 'weather-night' if night else 'weather-sunny',
    'windy': 'weather-windy', 'windy-variant': 'weather-windy-variant' } -%}
  mdi:{{ m.get(c, 'weather-cloudy') }}
{%- endmacro -%}

{%- macro _cond_text(cond) -%}
  {{- {'clear-night': 'Clear', 'partlycloudy': 'Partly cloudy', 'lightning-rainy': 'Thunderstorms',
       'snowy-rainy': 'Wintry mix', 'windy-variant': 'Windy', 'exceptional': 'Severe weather'}.get(cond, cond | replace('-', ' ') | capitalize) -}}
{%- endmacro -%}

{#- One line on rain for the rest of today (or the next 12 hours at night). -#}
{%- macro rain_line(hourly) -%}
  {%- set late = now().hour >= 20 -%}
  {%- set window = hourly[:12] if late else (hourly | selectattr('hour', '>=', now().hour) | selectattr('hour', '<=', 21) | list) -%}
  {%- set wet = window | selectattr('rain', '>=', 30) | list -%}
  {%- if wet -%}
    {%- set peak = wet | map(attribute='rain') | max -%}
    {%- set first, last = wet[0], wet[-1] -%}
    {{ '☔ Rain likely' if peak >= 50 else '🌦️ Chance of rain' }} {{ first.t if first == last else first.t ~ '–' ~ last.t }} · up to {{ peak }}%
  {%- else -%}
    ☀️ No rain expected {{ 'tonight' if late else 'today' }}
  {%- endif -%}
{%- endmacro -%}

{#- Weather advice chips, shown under the clothing tip; empty when none applies.
    - Open the windows: it is 60-72°F out now, the dew point is under 60°F,
      the rain chance stays under 20% for the next 3 hours, and it is between
      7 AM and 8 PM. There is no air-quality data, so smoky days aren't caught.
    - Windy: the forecast wind reaches 20 mph or more in the next 12 hours.
    The card styles .chip (see weather_today.yaml / weather_full.yaml). -#}
{%- set WINDOW_TEMP_MIN = 60 -%}
{%- set WINDOW_TEMP_MAX = 72 -%}
{%- set WINDOW_DEW_MAX = 60 -%}
{%- set WINDOW_RAIN_MAX = 20 -%}
{%- set WINDOW_HOURS = [7, 20] -%}
{%- set WIND_MPH = 20 -%}
{%- macro weather_advice(hourly) -%}
  {%- set temp = state_attr(WX, 'temperature') -%}
  {%- set dew = hourly[0].dew if hourly else none -%}
  {%- set rain_soon = hourly[:3] | map(attribute='rain') | max if hourly else 100 -%}
  {%- if temp is number and dew is number
        and WINDOW_TEMP_MIN <= temp <= WINDOW_TEMP_MAX and dew < WINDOW_DEW_MAX
        and rain_soon < WINDOW_RAIN_MAX
        and WINDOW_HOURS[0] <= now().hour < WINDOW_HOURS[1] -%}
<span class="chip"><ha-icon icon="mdi:window-open-variant"></ha-icon> Nice out: open the windows</span>
  {%- endif -%}
  {%- set ns = namespace(when=none, peak=0) -%}
  {%- for h in hourly[:12] -%}
    {%- if h.wind is number and h.wind >= WIND_MPH -%}
      {%- if ns.when is none %}{% set ns.when = 'now' if loop.first else 'from ' ~ h.t %}{% endif -%}
      {%- set ns.peak = [ns.peak, h.wind] | max -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if ns.when is not none -%}
    {%- set when = ns.when -%}
<span class="chip"><ha-icon icon="mdi:weather-windy"></ha-icon> Windy {{ when }} · up to {{ ns.peak }} mph</span>
  {%- endif -%}
{%- endmacro -%}

{#- Calendar icons picked from words in the event title (whole words, any
    case). First match wins, so holidays come before meals
    ("Thanksgiving dinner" gets the turkey); no match shows no icon. -#}
{%- set EVENT_ICONS = [
  ('thanksgiving', 'mdi:food-turkey'),
  ('christmas', 'mdi:pine-tree'),
  ('halloween', 'mdi:halloween'),
  ('birthday|bday', 'mdi:cake-variant'),
  ('anniversary', 'mdi:heart-outline'),
  ('wedding', 'mdi:ring'),
  ('dentist|orthodontist', 'mdi:tooth-outline'),
  ('doctor|dr|checkup|physical', 'mdi:stethoscope'),
  ('vet', 'mdi:paw'),
  ('haircut|barber', 'mdi:content-cut'),
  ('flight|airport', 'mdi:airplane'),
  ('trip|vacation|beach', 'mdi:bag-suitcase'),
  ('gym|workout|yoga', 'mdi:dumbbell'),
  ('dinner|lunch|brunch|breakfast', 'mdi:silverware-fork-knife'),
  ('concert', 'mdi:music'),
  ('party', 'mdi:party-popper'),
  ('trash|recycling', 'mdi:trash-can-outline')
] -%}
{%- macro event_icon(title) -%}
  {%- set t = (title or '') | lower -%}
  {%- set ns = namespace(icon='') -%}
  {%- for words, icon in EVENT_ICONS if not ns.icon and t is search('\\b(' ~ words ~ ')\\b') -%}
    {%- set ns.icon = icon -%}
  {%- endfor -%}
  {%- if ns.icon %}<ha-icon icon="{{ ns.icon }}"></ha-icon> {% endif -%}
{%- endmacro -%}

{#- One event line: calendar dot, keyword icon (not on the birthday
    calendar, whose dot is already a cake), time, title. -#}
{%- set CAL_DOTS = {'matt': '🔵', 'partner': '🩷', 'family': '🟢', 'birthday': '🎂'} -%}
{%- macro event_line(e) -%}
{{ CAL_DOTS.get(e.who, '📅') }} {% if e.who != 'birthday' %}{{ event_icon(e.title) }}{% endif %}{% if e.time %}**{{ e.time }}** {% endif %}{{ e.title }}
{%- endmacro -%}

{#- Countdown lines (sensor.kitchen_today_events `countdowns`), up to `limit`.
    Skips anything `min_days` away or closer, for lists that already show it. -#}
{%- macro countdown_lines(limit=2, min_days=0) -%}
  {%- set cds = (state_attr('sensor.kitchen_today_events', 'countdowns') or []) | selectattr('days', '>', min_days) | list -%}
  {%- for c in cds[:limit] %}
{{ CAL_DOTS.get(c.who, '📅') }} <ha-icon icon="mdi:flag-outline"></ha-icon> **{{ c.title }}** {{ 'tomorrow' if c.days == 1 else 'in ' ~ c.days ~ ' days' }} · {{ c.day }}
  {%- endfor -%}
{%- endmacro -%}

{#- Attention chips for the top of the kitchen page (sensor.kitchen_attention).
    The card styles .chip (dashboards/components/shared/attention.yaml). -#}
{%- macro attention_chips() -%}
  {%- for i in state_attr('sensor.kitchen_attention', 'items') or [] -%}
<span class="chip"><ha-icon icon="{{ i.icon }}"></ha-icon> {{ i.text }}</span>
  {%- endfor -%}
{%- endmacro -%}

{#- Weather card. full=false: now + rain line + 2-hourly strip (morning).
    full=true: adds the next five days. -#}
{%- macro weather_panel(full=false) -%}
  {%- set hourly = state_attr('sensor.kitchen_weather', 'hourly') or [] -%}
  {%- set daily = state_attr('sensor.kitchen_weather', 'daily') or [] -%}
  {%- set hi = state_attr('sensor.kitchen_weather', 'today_hi') -%}
  {%- set lo = state_attr('sensor.kitchen_weather', 'tonight_lo') -%}
  {%- set temp = state_attr(WX, 'temperature') -%}
  {%- set cond = states(WX) -%}
  {%- set night = is_state('sun.sun', 'below_horizon') -%}
  {%- set now_pop = hourly[0].rain if hourly else 0 -%}
# <ha-icon icon="{{ wx_icon(cond, now_pop, night) }}"></ha-icon> {{ temp | round(0) | int if temp is number else '—' }}° · {{ _cond_text('cloudy' if cond in ['rainy'] and now_pop < 30 else cond) }}

{#- The full panel's 5-day strip already shows today's high and low. -#}
{% if not (full and daily) %}
### {% if hi is not none %}High {{ hi }}° · {% endif %}{% if lo is not none %}Low {{ lo }}°{% endif %}
{%- endif %}
{%- set wear = states('sensor.commute_weather') %}
{%- if wear not in ['unknown', 'unavailable', 'None', ''] %}

### {{ wear }}
{%- endif %}
{%- set advice = weather_advice(hourly) %}
{%- if advice | trim %}

{{ advice }}
{%- endif %}

**{{ rain_line(hourly) }}**

{#- Now plus up to three upcoming key times: noon, heading home, evening
    (8 AM next morning once it's late). -#}
{%- set ns = namespace(cells=[]) -%}
{%- if hourly -%}
  {%- set ns.cells = [{'label': 'Now', 'h': hourly[0]}] -%}
  {%- for h in hourly[1:] if h.hour in [8, 12, 17, 20] and ns.cells | length < 4 -%}
    {%- set ns.cells = ns.cells + [{'label': 'Noon' if h.hour == 12 else h.t, 'h': h}] -%}
  {%- endfor -%}
{%- endif %}
{% if ns.cells %}
<table>
<tr>{% for c in ns.cells %}<td>{{ c.label }}</td>{% endfor %}</tr>
<tr>{% for c in ns.cells %}<td><ha-icon icon="{{ wx_icon(c.h.cond, c.h.rain, c.h.hour >= 18 or c.h.hour < 7) }}"></ha-icon></td>{% endfor %}</tr>
<tr>{% for c in ns.cells %}<td><b>{{ c.h.temp }}°</b></td>{% endfor %}</tr>
</table>
{% endif %}
{% if full and daily %}

---

<table>
<tr>{% for d in daily %}<td>{{ 'Today' if loop.first and d.day == now().strftime('%a') else d.day }}</td>{% endfor %}</tr>
<tr>{% for d in daily %}<td><ha-icon icon="{{ wx_icon(d.cond, d.rain) }}"></ha-icon></td>{% endfor %}</tr>
<tr>{% for d in daily %}<td><b>{{ d.hi }}°</b> {{ d.lo if d.lo is not none else '' }}{{ '°' if d.lo is not none else '' }}</td>{% endfor %}</tr>
</table>
{% endif %}
{%- endmacro -%}

{#- Today's events as short lines, then any countdowns. -#}
{%- macro today_events(limit=4) -%}
  {%- set evs = state_attr('sensor.kitchen_today_events', 'events') or [] -%}
  {%- for e in evs[:limit] -%}
{{ event_line(e) }}
{% endfor -%}
  {%- if evs | length > limit %}…and {{ evs | length - limit }} more{% endif -%}
  {%- if not evs %}Nothing on the calendar{% endif -%}
  {{- countdown_lines(2) -}}
{%- endmacro -%}

{#- Fridays: today, Saturday and Sunday in one list (the weekend attribute
    is only filled on Fridays). Each day shows up to `limit` events, then
    countdowns to anything after Sunday. -#}
{%- macro weekend_events(limit=4) -%}
  {%- set today = {'day': 'Today', 'events': state_attr('sensor.kitchen_today_events', 'events') or []} -%}
  {%- for d in [today] + (state_attr('sensor.kitchen_today_events', 'weekend') or []) -%}
**{{ d.day }}**
{% for e in d.events[:limit] -%}
{{ event_line(e) }}
{% endfor -%}
{%- if d.events | length > limit %}…and {{ d.events | length - limit }} more
{% endif -%}
{%- if not d.events %}Nothing planned yet
{% endif %}
{% endfor -%}
  {%- set cds = countdown_lines(2, 2) -%}
  {%- if cds | trim %}
**Coming up**{{ cds }}
  {%- endif -%}
{%- endmacro -%}

{#- One line for chores, or empty when nothing is due. -#}
{%- macro chores_line() -%}
  {%- set a = states.sensor.home_keeper_tasks.attributes if states.sensor.home_keeper_tasks is not none else {} -%}
  {%- set overdue = a.get('overdue', 0) or 0 -%}
  {%- set today = a.get('due_today', 0) or 0 -%}
  {%- if overdue or today -%}
🧹 **{{ [overdue ~ ' overdue' if overdue else '', today ~ ' due today' if today else ''] | select | join(' · ') }}** · next: {{ a.get('next_task_name', '—') }}
  {%- endif -%}
{%- endmacro -%}
