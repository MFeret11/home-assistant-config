{#- Shared logic for the game-soon sensors in packages/sports.yaml.
    Returns 'true' while a Team Tracker team's game is live, starts within
    24 hours, or ended (started) less than 12 hours ago, so the final
    score stays up for the evening. -#}
{%- macro game_soon(entity) -%}
  {%- set s = states(entity) -%}
  {%- set d = as_datetime(state_attr(entity, 'date')) -%}
  {{- (s == 'IN'
       or (d is not none and (
         (s == 'PRE' and d - now() < timedelta(hours=24))
         or (s == 'POST' and now() - d < timedelta(hours=12))))) | lower -}}
{%- endmacro -%}

{#- Networks the house can watch without cable: Philly over-the-air channels
    (antenna / HDHomeRun) plus the streaming services we have. Each name in
    Team Tracker's tv_network ("ESPN/ABC") is checked and the first match is
    returned, or empty when none can be watched. -#}
{%- macro watchable_network(tv) -%}
  {%- set ok = ['ABC', 'CBS', 'NBC', 'FOX', 'PHL17', 'NBC10', '6ABC', 'CBS3', 'FOX29',
                'PRIME VIDEO', 'AMAZON PRIME VIDEO', 'NETFLIX'] -%}
  {%- set ns = namespace(hit='') -%}
  {%- for n in (tv or '').split('/') if not ns.hit and n | trim | upper in ok -%}
    {%- set ns.hit = n | trim -%}
  {%- endfor -%}
  {{- ns.hit -}}
{%- endmacro -%}

{#- Games card (dashboards/components/shared/games.yaml, on Kitchen and Home): one row per
    team whose game is live, starts within 24 hours or just ended. Shows
    abbreviations, a short start time ("Sun 1 PM"), the live score, or the final. -#}
{%- macro game_row(entity) -%}
  {%- set s = states(entity) -%}
  {%- set a = states[entity].attributes if states[entity] is not none else {} -%}
  {%- set d = as_datetime(a.get('date')) -%}
  {%- set d = d | as_local if d is not none else none -%}
  {%- set away = a.get('team_homeaway') == 'away' -%}
  {%- if s == 'PRE' -%}
    {%- set mid = 'at' if away else 'vs' -%}
    {%- if d is none -%}{%- set when = 'Upcoming' -%}
    {%- else -%}
      {%- set days = (d.date() - now().date()).days -%}
      {#- Kept short: "Today 7 PM", "Sun 1 PM", "Mon 7:30 PM". -#}
      {%- set day = 'Today' if days == 0 else d.strftime('%a') -%}
      {%- set when = day ~ ' ' ~ d.strftime('%-I %p' if d.minute == 0 else '%-I:%M %p') -%}
    {%- endif -%}
    {%- set note = watchable_network(a.get('tv_network')) -%}
  {%- else -%}
    {%- set mid = (a.get('team_score') or '0') ~ ' – ' ~ (a.get('opponent_score') or '0') -%}
    {%- if s == 'POST' -%}{%- set when = 'Final' -%}{%- set note = '' -%}
    {%- else -%}
      {%- set q, clock = a.get('quarter'), a.get('clock') -%}
      {#- Team Tracker's clock often carries the period already ("6:02 - 1st"). -#}
      {%- set when = clock if (a.get('sport') == 'baseball' or not q or ' - ' in (clock or '')) else (('P' if a.get('sport') == 'hockey' else 'Q') ~ q ~ ' · ' ~ clock) -%}
      {%- set when = '🔴 ' ~ (when or 'Live') -%}
      {%- set note = watchable_network(a.get('tv_network')) -%}
    {%- endif -%}
  {%- endif -%}
<tr><td class="teams"><img src="{{ a.get('team_logo') }}" height="22"> {{ a.get('team_abbr') or '—' }} <span class="mid">{{ mid }}</span> {{ a.get('opponent_abbr') or '—' }} <img src="{{ a.get('opponent_logo') }}" height="22"></td><td class="when">{% if note %}<span class="note">{{ note }} · </span>{% endif %}<b>{{ when }}</b></td></tr>
{%- endmacro -%}

{%- macro games_panel() -%}
<table>
{%- for e in ['sensor.philadelphia_eagles', 'sensor.nba_philadelphia_76ers',
              'sensor.mlb_philadelphia_phillies', 'sensor.nhl_philadelphia_flyers']
    if game_soon(e) | string | trim == 'true' %}
{{ game_row(e) }}
{%- endfor %}
</table>
{%- endmacro -%}
